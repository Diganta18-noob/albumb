# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# Repository driver
#   Leave MONGODB_URI empty -> in-memory repo, hydrated from the seed
#   content. Set it -> MongoDB Atlas via Mongoose.
# ------------------------------------------------------------------
MONGODB_URI=

# ------------------------------------------------------------------
# Storage driver
#   STORAGE_DRIVER=local       -> uploads/ on this machine (multer+sharp)
#   STORAGE_DRIVER=cloudinary  -> Cloudinary (needs CLOUDINARY_*)
# ------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Public base URL the web app uses to reach uploaded files in local mode.
PUBLIC_BASE_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Auth
#   email/password JWT always on. Google OAuth registers only when
#   GOOGLE_CLIENT_ID is set.
# ------------------------------------------------------------------
JWT_SECRET=change-me-in-production-please
# In local mode, seed the first admin from this env (email / password).
SEED_ADMIN_EMAIL=admin@training.local
SEED_ADMIN_PASSWORD=admin12345

# ------------------------------------------------------------------
# Seed imagery
#   picsum -> real photographs from picsum.photos (needs network)
#   local  -> generated duotone SVGs (fully offline)
# ------------------------------------------------------------------
SEED_IMAGE_SOURCE=picsum

# ------------------------------------------------------------------
# Optional Google OAuth (only used when GOOGLE_CLIENT_ID is present)
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
